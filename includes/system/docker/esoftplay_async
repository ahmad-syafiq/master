#!/bin/bash
#
# esoftplay_async       Bring up/down networking
#
# chkconfig: 2345 10 90
# description: Activates/Deactivates asyncronous in esoftplay framework \
#              start at boot time.
#
### BEGIN INIT INFO
# Provides:          esoftplay_async
# Required-Start:    $local_fs $network $remote_fs
# Required-Stop:     $local_fs $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Menjalankan service esoftplay_async
### END INIT INFO

# Include functions
if [ -f "/lib/lsb/init-functions" ]; then
  . /lib/lsb/init-functions
fi

if [ -f "/etc/init.d/functions" ]; then
  . /etc/init.d/functions
fi

start() {
  echo -n "Starting async: "
  touch /opt/async.log
  chmod 777 /opt/async.log
  rm -f /opt/async.socket
  dtach -n /opt/async.socket /bin/bash /var/www/html/master/includes/system/docker/esoftplay_worker
}

stop() {
  echo -n "stopping async: "
  if [ -S "/opt/async.socket" ]; then
    pkill dtach
    rm -f /opt/async.socket
  fi
}

status() {
  if [ -S "/opt/async.socket" ]; then
    echo -n "ACTIVE async: $(wc -l < /opt/async.log) - $(wc -l < /tmp/async.log)"
  else
    echo -n "inactive async...."
  fi
}

case "$1" in
  start)
    start
    ;;
  stop)
    stop
    ;;
  restart)
    stop
    start
    ;;
  status)
    status
    ;;
  *)
    echo "Usage: $NAME {start|stop|restart|status}" >&2
    exit 1
    ;;
esac

echo ""
exit 0